# Bridge3 Academy — environment variables
#
# Two kinds here:
#   NEXT_PUBLIC_... = visible in the browser. Safe to expose.
#   Everything else = SECRET. Server-only. Never share these, never commit
#   real values, and only paste them into Vercel's "Environment Variables"
#   settings (not into any file you push to GitHub).

# --- Supabase ---
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL ---
# Used to build email links and referral links correctly.
# Locally: http://localhost:3000
# In production: your real Vercel/custom domain, e.g. https://bridge3academy.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (email sending) ---
# Free tier: sign up at resend.com, create an API key under "API Keys."
RESEND_API_KEY=
# Optional -- defaults to Resend's shared test address if left blank.
# Once your domain is verified in Resend, change this to something like
# "Bridge3 Academy <hello@bridge3academy.com>"
WAITLIST_EMAIL_FROM=

# --- Cron / Keep-Alive ---
# Shared secret that protects the /api/cron/keep-alive endpoint from
# unauthorized requests. Generate any random string (e.g. `openssl rand -hex 32`).
# On Vercel, this is auto-injected if you name it CRON_SECRET.
CRON_SECRET=

# --- Text-to-Speech (AI Audio Generation) ---
# Provider options: 'google' (default, free tier), 'elevenlabs', or 'openai'
TTS_PROVIDER=google
GOOGLE_TTS_API_KEY=
# --- Registration Gate (Optional) ---
# By default, registration is closed ('false') for public and waitlist scholars.
# Only Admins and Mentors can log in.
# You can toggle this dynamically anytime in Mission Control -> Site Settings,
# or set NEXT_PUBLIC_REGISTRATION_OPEN=true when launching.
NEXT_PUBLIC_REGISTRATION_OPEN=false


